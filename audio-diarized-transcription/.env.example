# Copy to .env (gitignored) and edit. The offchain path needs none of this — the
# defaults match the compose file, so `docker compose up -d` works with no .env.
# Never commit secrets. Keystore dirs: absolute paths OUTSIDE this repo, mounted RO.

# Registry / tag of the runner image built via the runner repo's build-images.sh.
REGISTRY=moatus
TAG=v0.1.0

# Host port the runner is published on.
RUNNER_PORT=8080

# cuda (default) or cpu. cpu is only useful for the fake-engine streaming smoke.
NEMO_DEVICE=cuda

# Bounded route concurrency. 1 = one job at a time (a 2nd call returns 429).
NEMO_MAX_QUEUE_SIZE=1

# Max upload size (MB) accepted by POST /v1/audio/transcriptions.
NEMO_MAX_AUDIO_MB=100

# --- On-chain (paid) only below; offchain ignores these. ---

NETWORK=arbitrum-one-mainnet
ETH_RPC_URL=https://arb1.arbitrum.io/rpc

# Signer (payer): needs an on-chain deposit + reserve.
SIGNER_KEYSTORE_DIR=/absolute/path/to/signer-keystore
SIGNER_ETH_ACCT=0xYourSignerAddress
SIGNER_ETH_PASSWORD=your-signer-keystore-password

# Orchestrator operating key (split-key): needs ETH for gas to redeem tickets.
ORCH_KEYSTORE_DIR=/absolute/path/to/operator-keystore
ORCH_ETH_ACCT=0xYourOperatorAddress
ORCH_ETH_PASSWORD=your-operator-keystore-password
# Registered orch = ticket recipient (-ethOrchAddr); empty = use the operating key.
ORCH_ONCHAIN_ADDR=0xYourRegisteredOrchestrator

# Pricing (on-chain), in USD, converted to wei via the price feed.
PIXELS_PER_UNIT=1000
MAX_PRICE_PER_UNIT=0.10USD
