# Copy to .env and edit. All values are optional — the defaults match the
# compose file, so `docker compose up -d` works with no .env at all.

# Registry / tag of the runner image built via the runner repo's build-images.sh.
REGISTRY=moatus
TAG=v0.1.0

# Host port the runner is published on.
RUNNER_PORT=8080

# cuda (default) or cpu. cpu is only useful for the fake-engine streaming smoke.
NEMO_DEVICE=cuda

# Bounded route concurrency. 1 = one job at a time (a 2nd call returns 429).
NEMO_MAX_QUEUE_SIZE=1

# Max upload size (MB) accepted by POST /v1/audio/transcriptions.
NEMO_MAX_AUDIO_MB=100
