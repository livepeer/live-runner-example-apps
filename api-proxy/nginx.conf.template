# The whole runner: a stock nginx pins one Hugging Face model per route and
# injects the operator's token. HF_TOKEN is the only value substituted from the
# environment, by the nginx image's template mechanism.
#
# runners.json points each app id at its own path (http://app:8989/sd3), which
# the orchestrator preserves when forwarding, so each lands on its own block.
server {
    listen 8989;

    # One endpoint for both capabilities. `return 200` only reports that nginx is
    # up, never that a model or the token is good. Hugging Face exposes no
    # readiness endpoint, only metadata, and the orchestrator polls this every 5s
    # with a 3s timeout, so a real upstream check does not belong here.
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # The pinned URL is the security model: the operator's credential can only
    # be spent on exactly this model, callers choose nothing but the payload.
    # Method and query string are part of "nothing": nginx would forward both
    # upstream as the caller sent them, so pin the method and drop the args.
    location = /sd3/proxy {
        limit_except POST { deny all; }
        set $args '';
        proxy_pass https://router.huggingface.co/hf-inference/models/stabilityai/stable-diffusion-3-medium-diffusers;
        proxy_set_header Authorization "Bearer ${HF_TOKEN}";
        # Hugging Face content-negotiates: with the SDK's Accept:
        # application/json it answers with a base64 PNG in a JSON string
        # instead of the image. Ask for the image the runner promises.
        proxy_set_header Accept "image/jpeg";
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;  # a hosted diffusion model can take tens of seconds
    }

    # One more capability is one more location here plus one runners.json entry.
    # This one reads an image instead of making one, which is why it is its own
    # app id at its own price: same pinned-URL rule, a classifier costs a
    # fraction of a diffusion run, and the answer is JSON rather than an image.
    location = /vit/proxy {
        limit_except POST { deny all; }
        set $args '';
        # The payload is the same {"inputs": ...}, carrying a base64 image, so
        # the body is larger than nginx's 1m default allows.
        client_max_body_size 8m;
        proxy_pass https://router.huggingface.co/hf-inference/models/google/vit-base-patch16-224;
        proxy_set_header Authorization "Bearer ${HF_TOKEN}";
        # A runner answers with a JSON *object* or with opaque bytes, and this
        # upstream answers with a bare JSON array. Hand it back as text so it
        # travels whole and the client parses it; relabelling is the only thing
        # config can do about a body shape, since nginx does not rewrite bodies.
        proxy_hide_header Content-Type;
        add_header Content-Type "text/plain; charset=utf-8" always;
        proxy_ssl_server_name on;
        proxy_read_timeout 30s;  # one forward pass, not a diffusion run
    }
}
